# Database — defaults to a local SQLite file. For production point at Postgres+PostGIS:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/citypulse
DATABASE_URL=sqlite:///./citypulse.db

# Optional API-based connectors (AllEvents, Eventbrite & Cinepax scrapers need no key)
TICKETMASTER_API_KEY=

# Facebook/Instagram page events via the official Meta Graph API.
# Anonymous scraping of FB/IG/LinkedIn is login-walled, so a token is required.
META_ACCESS_TOKEN=
META_PAGE_IDS=

# Default city for the launch market
DEFAULT_CITY=Islamabad

# Ingestion cycle in minutes (background scheduler inside the API process)
INGEST_INTERVAL_MINUTES=20

# Shared secret for the admin moderation endpoints
ADMIN_API_KEY=change-me
